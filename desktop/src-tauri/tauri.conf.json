{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Monolith Notes",
  "version": "2.7.0",
  "identifier": "com.monolith.notes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Monolith Notes",
        "width": 1120,
        "height": 740,
        "minWidth": 800,
        "minHeight": 500
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
